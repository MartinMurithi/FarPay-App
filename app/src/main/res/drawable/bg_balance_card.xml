<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#08122C"
                android:endColor="#1A3370"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:bottom="0dp" android:left="140dp" android:right="0dp" android:top="60dp">
        <shape android:shape="oval">
            <solid android:color="#1500D4AA" />
        </shape>
    </item>
</layer-list>