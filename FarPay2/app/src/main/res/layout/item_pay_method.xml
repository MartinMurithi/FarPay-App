<?xml version="1.0" encoding="utf-8"?>
<!--
    Reusable large payment method selection card.

    IDs available for view binding:
      method_root      — root FrameLayout (set bg_method_selected / bg_method_default)
      iv_method_bg     — icon background circle View
      iv_method_icon   — ImageView for the method logo/icon
      tv_method_name   — method name (bold)
      tv_method_badge  — optional small pill badge ("Popular", "Instant") — GONE by default
      tv_method_desc   — subtitle (muted)
      brand_logos      — LinearLayout with Visa + Mastercard images — GONE by default
      radio_dot        — selection indicator View (bg_step_active when selected)
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/method_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_method_default"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="18dp">

        <!-- ── Icon container ── -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <View
                android:id="@+id/iv_method_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_action_circle" />

            <ImageView
                android:id="@+id/iv_method_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_pay_method_icon"
                android:src="@drawable/ic_pay"
                android:scaleType="fitCenter" />

        </FrameLayout>

        <!-- ── Text block ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name + badge on same row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_method_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_bold"
                    android:text="PesaPal"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_method_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_teal_pill"
                    android:fontFamily="@font/dm_sans_bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Popular"
                    android:textColor="@color/brand_accent"
                    android:textSize="10sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/tv_method_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/dm_sans"
                android:text="M-Pesa, Airtel Money &amp; more"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <!-- Brand logo row (Visa + MC) — hidden by default -->
            <LinearLayout
                android:id="@+id/brand_logos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:src="@drawable/ic_visa" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:src="@drawable/ic_mastercard" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Radio dot ── -->
        <View
            android:id="@+id/radio_dot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_radio_selector"
            android:contentDescription="@string/cd_not_selected" />

    </LinearLayout>

</FrameLayout>