<?xml version="1.0" encoding="utf-8"?>
<!--
    Step 1 — Payer details (first name, last name, email, phone)
             + amount input with quick-select chips
             + optional description
             + Continue button
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_primary"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <!-- ═══════════════════════════════════
             SECTION A — WHO'S PAYING?
        ════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_bold"
            android:text="Who&#8217;s paying?"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/dm_sans"
            android:text="Enter your details to proceed"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <!-- First + Last name row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_first_name"
                style="@style/Widget.FarPay.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="@string/label_first_name"
                app:startIconDrawable="@drawable/ic_profile">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_first_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:fontFamily="@font/dm_sans"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_last_name"
                style="@style/Widget.FarPay.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/label_last_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_last_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:fontFamily="@font/dm_sans"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_email"
            style="@style/Widget.FarPay.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/label_email"
            app:startIconDrawable="@drawable/ic_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:fontFamily="@font/dm_sans"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phone -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_phone"
            style="@style/Widget.FarPay.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/label_phone"
            app:prefixText="+254 "
            app:startIconDrawable="@drawable/ic_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_phone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:fontFamily="@font/dm_sans"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══════════════════════════════════
             SECTION DIVIDER
        ════════════════════════════════════ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="28dp"
            android:background="@color/divider" />

        <!-- ═══════════════════════════════════
             SECTION B — AMOUNT
        ════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_bold"
            android:text="How much?"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/dm_sans"
            android:text="Enter the amount you want to send"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <!-- Amount block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_amount_surface"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/dm_sans"
                android:letterSpacing="0.06"
                android:text="@string/label_amount_kes"
                android:textAllCaps="true"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />

            <!-- KES prefix + raw EditText -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/sora_bold"
                    android:text="KES"
                    android:textColor="@color/brand_accent"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/et_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/sora_bold"
                    android:hint="0.00"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/navy_800"
                    android:textColorHint="@color/grey_300"
                    android:textSize="38sp" />

            </LinearLayout>

            <!-- Teal underline -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:alpha="0.35"
                android:background="@color/brand_accent" />

        </LinearLayout>

        <!-- Quick amount chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_amounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:chipSpacingHorizontal="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_500"
                style="@style/Widget.FarPay.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_amount_500" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_1000"
                style="@style/Widget.FarPay.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_amount_1k" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_2500"
                style="@style/Widget.FarPay.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_amount_2500" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_5000"
                style="@style/Widget.FarPay.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_amount_5k" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_10000"
                style="@style/Widget.FarPay.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_amount_10k" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Description (optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_description"
            style="@style/Widget.FarPay.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/label_description_optional"
            app:startIconDrawable="@drawable/ic_bill"
            app:helperText="@string/label_description_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:fontFamily="@font/dm_sans"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══════════════════════════════════
             CONTINUE BUTTON
        ════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            style="@style/Widget.FarPay.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="32dp"
            android:text="@string/action_continue" />

        <!-- Secure note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:text="@string/pay_secure_note"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>