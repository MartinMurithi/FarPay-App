<?xml version="1.0" encoding="utf-8"?>
<!--
    Step 2 — Payment method selection.
    Top: dark summary card showing payer name, amount, fee, total.
    Middle: 3 large selectable method cards.
    Bottom: fixed footer with selected method row + Pay Now button.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_primary"
    android:orientation="vertical">

    <!-- Scrollable body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- ═══════════════════════════════════
                 SUMMARY CARD — dark navy
            ════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FarPay.Card.Dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardCornerRadius="20dp"
                app:contentPadding="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Summary label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:fontFamily="@font/dm_sans"
                        android:letterSpacing="0.1"
                        android:text="@string/pay_summary_title"
                        android:textAllCaps="true"
                        android:textColor="#80FFFFFF"
                        android:textSize="11sp" />

                    <!-- Paying as -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans"
                            android:text="@string/pay_summary_paying_as"
                            android:textColor="#80FFFFFF"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tv_summary_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans_medium"
                            android:text="—"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Amount -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans"
                            android:text="@string/pay_summary_amount"
                            android:textColor="#80FFFFFF"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tv_summary_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans_medium"
                            android:text="KES 0.00"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Fee -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans"
                            android:text="@string/pay_summary_fee"
                            android:textColor="#80FFFFFF"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tv_summary_fee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans_medium"
                            android:text="@string/pay_fee_free"
                            android:textColor="@color/brand_accent"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="18dp"
                        android:background="#20FFFFFF" />

                    <!-- Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans_bold"
                            android:text="@string/pay_summary_total"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tv_summary_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sora_bold"
                            android:text="KES 0.00"
                            android:textColor="@color/brand_accent"
                            android:textSize="22sp" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════
                 METHOD HEADING
            ════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_bold"
                android:text="@string/pay_choose_method"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/dm_sans"
                android:text="@string/pay_method_subtitle"
                android:textColor="@color/text_hint"
                android:textSize="13sp" />

            <!-- ── PesaPal ── -->
            <include
                android:id="@+id/card_pesapal"
                layout="@layout/item_pay_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- ── Visa / Mastercard ── -->
            <include
                android:id="@+id/card_visa"
                layout="@layout/item_pay_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- ── Bank Transfer ── -->
            <include
                android:id="@+id/card_bank"
                layout="@layout/item_pay_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════
         FIXED FOOTER — Pay Now button
    ════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- Selected method strip — hidden until a method is chosen -->
        <LinearLayout
            android:id="@+id/row_selected_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@color/grey_50"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <!-- Method icon -->
            <ImageView
                android:id="@+id/iv_selected_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/cd_pay_method_icon"
                android:src="@drawable/ic_pay" />

            <!-- Method name -->
            <TextView
                android:id="@+id/tv_selected_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans_medium"
                android:text="PesaPal"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Change link -->
            <TextView
                android:id="@+id/tv_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/dm_sans_medium"
                android:text="@string/action_change"
                android:textColor="@color/brand_accent"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Pay Now -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pay_now"
            style="@style/Widget.FarPay.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:enabled="false"
            android:text="@string/action_pay_now" />

        <!-- Secure note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:text="@string/pay_secure_note"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>